# ============================================================
# Foca deployment configuration
# Copy this to .env on the deployment host and fill in values.
# DO NOT commit your filled .env to git.
# ============================================================

# --- Image version ---
# Set to vX.Y.Z (e.g. v2.25.1) to pin a specific release. Use 'latest'
# only for non-production instances (afumati, dev) where you want
# automatic updates on every push to main.
IMAGE_TAG=latest

# --- Branding (instance-specific) ---
PLATFORM_NAME=Foca
COMPANY_NAME=Focalabs
BOT_NAME=Foca
PLATFORM_TITLE=Foca | Focalabs

# --- Required secrets (block startup if unset) ---
ANTHROPIC_API_KEY=replace_me
JWT_SECRET=replace_me

# --- Encryption for stored LLM provider keys (conditional) ---
# Required only if you'll add LLM providers through the Admin UI
# (recommended for new deployments — lets you rotate keys without
# editing .env). Not needed if ANTHROPIC_API_KEY above is the only
# key source. The platform starts fine without it; only encrypt/
# decrypt operations against stored provider rows raise.
# Generate: openssl rand -base64 32
LLM_ENCRYPTION_KEY=replace_me

# --- Initial admin (used only on first run when auth.db is empty) ---
# After first startup, change the password through the Admin UI.
ADMIN_USERNAME=replace_me
ADMIN_PASSWORD=replace_me

# --- Mail (Zoho or Gmail; required for email features) ---
SMTP_SERVER=replace_me
SMTP_PORT=465
SMTP_USERNAME=replace_me
SMTP_PASSWORD=replace_me
SMTP_FROM_NAME=replace_me

IMAP_SERVER=replace_me
IMAP_PORT=993
IMAP_USERNAME=replace_me
IMAP_PASSWORD=replace_me

# --- Optional features ---
# Comma-separated; remove modules to disable.
# Available: rag, address
ENABLED_MODULES=rag,address

# Local LLM fallback (Ollama). LLM_MODE=local routes calls there.
# Leave LLM_MODE=claude for cloud-only deployments.
LLM_MODE=claude
# OLLAMA_HOST=
# OLLAMA_PORT=11434
# OLLAMA_MODEL=aya:8b

# Per-user spend cap (USD). When false, no quota enforcement runs.
QUOTA_ENABLED=false
QUOTA_DEFAULT_LIMIT_USD=2.00

# Cross-encoder reranker (CPU-only, ~2.4s warm load).
RERANKER_ENABLED=true

# --- Web server ---
# NGINX_PROFILE selects which nginx config the container uses:
#   http-only        — plain HTTP on port 80. Use for: LAN-only deploys,
#                      instances behind a TLS-terminating proxy
#                      (Cloudflare Tunnel, AWS ALB, Traefik, etc.)
#   prod-letsencrypt — listens on 80 (redirect) and 443 (HTTPS).
#                      Requires certbot-managed certs mounted at
#                      /etc/letsencrypt in the container (uncomment
#                      the volume mount in docker-compose.yml).
NGINX_PROFILE=http-only

# APP_DOMAIN, LANDING_DOMAIN, LETSENCRYPT_DOMAIN are only used by
# prod-letsencrypt profile — http-only ignores them and accepts any host.
# LANDING_DOMAIN may be a comma-separated list (entrypoint converts
# commas to spaces before nginx sees them).
APP_DOMAIN=app.example.com
LANDING_DOMAIN=example.com,www.example.com
LETSENCRYPT_DOMAIN=example.com

# Maximum upload size for /api/ requests. Increase for clients with
# large legal/scanned documents.
MAX_UPLOAD_SIZE=50m

# --- Production hardening ---
# MUST be false in deployment — when true, JWT cookies omit Secure flag
# (only safe on localhost / LAN HTTP).
DEBUG=false

# --- Observability (optional) ---
LANGFUSE_ENABLED=false
# LANGFUSE_PUBLIC_KEY=
# LANGFUSE_SECRET_KEY=
# LANGFUSE_HOST=

# ============================================================
# Notes on persistent state
# ============================================================
# All state lives in /srv/foca/data/ on the host as bind mounts.
# The backend container writes its 12 SQLite databases under
# /srv/foca/data/sqlite/:
#
#   auth.db              — users + per-user permission overrides
#   audit.db             — unified audit log
#   chat_history.db      — conversations, messages, FTS
#   usage.db             — token tracking + per-user quotas
#   jobs.db              — API-layer background jobs
#   email_audit.db       — sent-email audit trail
#   reminders.db         — per-user reminders
#   address_batches.db   — address-correction module history
#   notifications.db     — in-app notifications
#   chat_attachments.db  — chat-scoped file metadata
#   api_cache.db         — connector API response cache
#   platform.db          — briefing, dashboard widgets, LLM providers,
#                          implementation memory, news feeds, scheduled
#                          job runs (six modules share this DB)
#
# See DEPLOY.md for backup guidance.
